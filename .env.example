# ======================================
# Bot AI - ELENA Environment Variables
# ======================================
# Copy this file to .env and fill in your keys
# DO NOT commit .env to git (it's in .gitignore)

# Mode Local (Ollama) — set true untuk pakai Qwen local
USE_LOCAL_MODEL=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Groq AI API Key (digunakan jika USE_LOCAL_MODEL=false atau di Vercel)
GROQ_API_KEY=''

# Google/Gemini API Key (opsional, untuk web search)
GOOGLE_API_KEY=''
GOOGLE_CX=''

# Server Port (default: 3000)
PORT=3000
