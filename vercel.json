{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/openai/(.*)", "dest": "api/index.js" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
