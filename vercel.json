{
  "version": 2,
  "builds": [
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/chat.js" },
    { "src": "/(.*)", "dest": "public/$1" }
  ],
  "env": {
    "GROQ_API_KEY": "@groq_api_key"
  }
}
