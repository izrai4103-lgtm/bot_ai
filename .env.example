# ======================================
# Bot AI - ELENA Environment Variables
# ======================================
# Copy this file to .env and fill in your keys
# DO NOT commit .env to git (it's in .gitignore)

# GROQ AI API Key (wajib)
# Dapatkan di: https://console.groq.com/keys
GROQ_API_KEY=''

# Google/Gemini API Key (opsional, untuk web search)
# Dapatkan di: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=''

# Google Custom Search Engine ID (opsional, untuk web search)
# Dapatkan di: https://programmablesearchengine.google.com/
GOOGLE_CX=''

# Server Port (default: 3000)
PORT=3000
